DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_cold_email
JWT_SECRET=supersecretkeychangeinproduction
JWT_REFRESH_SECRET=supersecretrefreshkeychangeinproduction
# LLM provider: "ollama" (local Gemma) or "gemini" (cloud)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b
OLLAMA_TEMPERATURE=0.7
OLLAMA_NUM_CTX=8192
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
VECTOR_STORE=faiss
UPLOAD_DIRECTORY=./storage/documents
MAX_UPLOAD_SIZE=5000000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
